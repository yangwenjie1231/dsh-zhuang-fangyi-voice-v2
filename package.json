{
  "name": "dsh-zhuang-fangyi-voice-v2",
  "version": "0.4.0",
  "description": "庄方宜专属中文音色合成 for DeepSeek Harness —— 把任意中文台词用她的声音念出来，支持三种语气风格。DSH 插件这一半负责托管 Python 推理服务（生命周期/常驻/显存释放），并通过 `zfhVoiceV2` 服务把合成能力暴露给其它插件（桌宠用它念 AI 的回答）。",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "tts",
    "voice-clone",
    "gpt-sovits",
    "zhuang-fangyi"
  ],
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "src",
    "locale/*.json",
    "icon.svg",
    "tools",
    "docs",
    "assets",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "dsh": ">=0.2.2-0",
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "scripts": {
    "check": "node --check index.js",
    "test": "node --check index.js && node --check client.js && node tools/test-plugin.mjs && node tests/test_dsh_022_contract.mjs",
    "test:e2e": "node tools/e2e-diagnose.mjs",
    "styles": "python -m zfh_voice2 styles"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.2.0-0",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.2.0-0",
    "react": "^18.2.0",
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "devDependencies": {
    "@deepseek-ai/schemastery": "3.19.0"
  }
}
