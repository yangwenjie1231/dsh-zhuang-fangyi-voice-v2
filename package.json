{
  "name": "dsh-zhuang-fangyi-voice-v2",
  "version": "0.2.0",
  "description": "庄方宜专属中文音色合成 for DeepSeek Harness —— 把任意中文台词用她的声音念出来，支持三种语气风格。DSH 插件这一半负责托管 Python 推理服务（生命周期/常驻/显存释放），并通过 `zfhVoiceV2` 服务把合成能力暴露给其它插件（桌宠用它念 AI 的回答）。",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "tts",
    "voice-clone",
    "gpt-sovits",
    "zhuang-fangyi"
  ],
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "src",
    "tools",
    "docs",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "check": "node --check index.js",
    "test": "node --check index.js && node tools/test-plugin.mjs",
    "test:e2e": "node tools/e2e-diagnose.mjs",
    "styles": "python -m zfh_voice2 styles"
  }
}
